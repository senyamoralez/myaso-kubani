# Токен от @BotFather (никому не показывайте)
BOT_TOKEN=

# ID рабочей группы сотрудников. Добавьте бота в группу и отправьте туда /id
STAFF_CHAT_ID=

# Адрес сайта, с которого принимать заказы (например https://myaso-kubani.ru). * — с любого
ALLOWED_ORIGIN=*

# Порт сервера
PORT=8080

# Данные магазина
SHOP_NAME=Мясо Кубани и стейки
SHOP_PHONE=+7 926 244-37-37
PICKUP_ADDRESS=Таллинская, 7, ТЦ «Московская ярмарка», 1 этаж

# Доставка: стоимость и порог бесплатной доставки (должны совпадать с сайтом)
DELIVERY_FEE=500
FREE_DELIVERY_FROM=5000

# Файл с QR-кодом СБП для оплаты (картинка из банка, лежит рядом с server.js)
PAY_QR_FILE=pay-qr.png
PAY_NOTE=Оплата по QR-коду СБП на счёт магазина. В назначении платежа укажите номер заказа.

# Во сколько присылать итоги дня в рабочий чат
DAILY_SUMMARY_AT=21:00

# ---------- Личный кабинет ----------
# Секрет для подписи кодов и сессий. Если пусто — сгенерируется сам и сохранится в data/.secret
SECRET=
# Cookie входа: на рабочем сервере с HTTPS оставьте true
COOKIE_SECURE=true
# Если сайт на myaso-kubani.ru, а сервер на api.myaso-kubani.ru — укажите .myaso-kubani.ru (можно оставить пустым)
COOKIE_DOMAIN=
# Бонусы
WELCOME_BONUS=300
BIRTHDAY_BONUS=1000
# Какую долю заказа можно оплатить бонусами (0.3 = 30%)
MAX_BONUS_SHARE=0.3
# Уровни: порог суммы покупок и процент кешбэка
LEVELS=[{"name":"Choice","from":0,"rate":0.03},{"name":"Prime","from":20000,"rate":0.05},{"name":"Вагю A5","from":60000,"rate":0.07}]

# SMS как запасной способ входа (необязательно, платно). Сейчас поддерживается sms.ru
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
